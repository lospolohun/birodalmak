{
  "name": "age-of-the-crystals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AGE OF THE CRYSTALS - bongeszos RTS (AoE-orokos) WebGL2/Three.js motorral, determinisztikus lockstep-kesz szimulacioval",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "det": "node tools/determinizmus_szonda.mjs",
    "fps": "node tools/fps_szonda.mjs",
    "szonda": "npm run det && npm run halo && npm run civ && npm run menu && npm run hang && npm run panelek && npm run kiadas && npm run build && npm run fps",
    "halo": "node tools/halozat_szonda.mjs",
    "civ": "node tools/civ_valaszto_szonda.mjs",
    "menu": "node tools/menu_szonda.mjs",
    "hang": "node tools/hang_szonda.mjs",
    "kiadas": "node tools/kiadas_ellenorzo.mjs",
    "relay": "node server/relay.mjs",
    "ikon": "node tools/ikon_szonda.mjs",
    "p:epites": "node tools/panel_epites_szonda.mjs",
    "p:kijeloles": "node tools/panel_kijeloles_szonda.mjs",
    "p:kepzes": "node tools/panel_kepzes_szonda.mjs",
    "p:tech": "node tools/panel_technologia_szonda.mjs",
    "p:uzenetek": "node tools/panel_uzenetek_szonda.mjs",
    "p:statisztika": "node tools/panel_statisztika_szonda.mjs",
    "p:minimap": "node tools/minimap_szonda.mjs",
    "panelek": "npm run ikon && npm run p:epites && npm run p:kijeloles && npm run p:kepzes && npm run p:tech && npm run p:uzenetek && npm run p:statisztika && npm run p:minimap",
    "portal:dev": "vite --config portal/vite.config.js",
    "portal:build": "vite build --config portal/vite.config.js",
    "portal:preview": "vite preview --config portal/vite.config.js",
    "portal:det": "node portal/tools/det_szonda.mjs",
    "portal:bongeszo": "node portal/tools/bongeszo_szonda.mjs",
    "portal:kep": "node portal/tools/kep.mjs",
    "portal:szonda": "npm run portal:det && npm run portal:mertan && npm run portal:build && npm run portal:bongeszo && npm run portal:hang && npm run portal:kiadas",
    "portal:mertan": "node portal/tools/mertan_szonda.mjs",
    "portal:hang": "node portal/tools/hang_szonda.mjs",
    "portal:kiadas": "node portal/tools/kiadas_ellenorzo.mjs"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "^5.4.11"
  }
}
